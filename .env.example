DATABASE_URL=postgres://user:pass@host/db
AUTH_SECRET=                   # >= 32 chars; openssl rand -hex 32
# Auth is via YouTrack Personal Access Token — users paste their PAT and their
# own workspace URL in the login form (Profile → Account Security → New token).
# No env var holds the PAT or the workspace URL — the app is workspace-agnostic.
# YT_BASE_URL is OPTIONAL — legacy fallback only, for accounts created before
# the per-user workspace column existed. Leave blank in new deployments.
YT_BASE_URL=
YT_TOKEN_ENC_KEY=              # base64-encoded 32 bytes; openssl rand -base64 32
# Optional — leave blank to auto-discover from the sprint's issues at session create.
# These act as fallback values used only when discovery returns nothing.
YT_SP_FIELD=
YT_DURATION_FIELD=
YT_DONE_STATE_NAMES=
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
